# OrchestrAI configuration
# Copy this file to .env and fill in what you have. The only external API
# used anywhere in this project is Groq — everything else runs on built-in
# logic, so the app works fully even with GROQ_API_KEY left blank.

# If set, the Intake Agent calls a Groq-hosted model for extraction (better
# on messy / multi-language input). Get a free key at console.groq.com ->
# API Keys. Without it, a transparent rule/keyword engine is used instead —
# the app runs identically either way, just with slightly less nuanced
# text understanding.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Risk thresholds that decide autonomy mode (can also be changed live by an
# Admin from the dashboard's Autonomy Policy panel while the app is running).
# score <= RISK_AUTO_MAX          -> AUTO (executes immediately)
# score <= RISK_SUPERVISED_MAX    -> SUPERVISED (AI proposes, human approves)
# score >  RISK_SUPERVISED_MAX    -> MANUAL (AI records the ticket but will
#                                    NOT call any external system itself —
#                                    a human has to carry it out and confirm)
RISK_AUTO_MAX=30
RISK_SUPERVISED_MAX=75

# Shared secret for the authenticated webhook trigger (POST /api/webhook with
# header "X-Webhook-Secret: <this value>"). This isn't a third-party key —
# it's a password you make up yourself. Leave blank to keep that endpoint
# closed entirely — it returns 503 with nothing set.
WEBHOOK_SECRET=

# How often (seconds) the background scheduler thread checks for due
# scheduled ("cron") requests. This thread runs for as long as the Flask
# process is alive, independent of the browser.
SCHEDULER_INTERVAL_SECONDS=5

# Chance (0.0-1.0) that a simulated downstream action call fails on its
# first two attempts, to demonstrate the Failure Recovery Agent's retry +
# alternative-path + escalate behavior. The on-disk ticket file itself never
# fails to write — only the simulated external call does.
FAILURE_SIMULATION_RATE=0.35

PORT=5000
